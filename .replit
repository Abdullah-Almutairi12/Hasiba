modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["pnpm", "run", "release:check"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "verify"

[[workflows.workflow]]
name = "verify"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run verify"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-2cff9f39-edcc-4ea1-b733-49785cde030c"
